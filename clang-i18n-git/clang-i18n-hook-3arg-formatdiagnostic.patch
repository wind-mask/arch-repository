+// ---------------------------------------------------------------------------
+// Hook for the 3-argument overload of Diagnostic::FormatDiagnostic.
+//
+// LLVM/Clang built with (Thin)LTO inlines both the 1-argument overload and
+// DiagnosticIDs::getDescription() into TextDiagnosticPrinter::HandleDiagnostic,
+// so patching/interposing the 1-argument overload has no effect on the normal
+// diagnostic output path: the only remaining (out-of-line) call there is the
+// one to this overload.  Hook it as well and translate the format string
+// before the real implementation substitutes the arguments.
+// ---------------------------------------------------------------------------
+#if defined(CLANG_I18N_LINK_DYLIB) &&                                        \
+    (defined(__x86_64__) || defined(__aarch64__) ||                          \
+     (defined(__loongarch__) && __loongarch_grlen == 64) ||                  \
+     (defined(__riscv) && __riscv_xlen == 64))
+
+// Size of the absolute jump that replaces the function entry.
+#if defined(__x86_64__)
+constexpr size_t JumpPatchSize = 12;  // movabs rax, <addr>; jmp rax
+#elif defined(__aarch64__)
+constexpr size_t JumpPatchSize = 16;  // ldr x16, 8; br x16; .quad <addr>
+#elif defined(__loongarch__) && __loongarch_grlen == 64
+constexpr size_t JumpPatchSize = 20;
+#else
+constexpr size_t JumpPatchSize = 18;  // riscv64
+#endif
+
+// Write an absolute jump to Target into Dst.
+static void WriteJump(uint8_t *Dst, const void *Target) {
+#if defined(__x86_64__)
+  uint8_t Patch[] = {// movabs rax, <Target>
+                     0x48, 0xb8, 0, 0, 0, 0, 0, 0, 0, 0,
+                     // jmp rax
+                     0xff, 0xe0};
+  memcpy(Patch + 2, &Target, sizeof(Target));
+#elif defined(__aarch64__)
+  uint8_t Patch[] = {// ldr x16, 0x8
+                     0x50, 0x00, 0x00, 0x58,
+                     // br x16
+                     0x00, 0x02, 0x1f, 0xd6,
+                     // .quad <Target>
+                     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+  memcpy(Patch + 8, &Target, sizeof(Target));
+#elif defined(__loongarch__) && __loongarch_grlen == 64
+  uint8_t Patch[] = {// pcaddu18i $t0, 0
+                     0x0c, 0x00, 0x00, 0x1e,
+                     // ld.d $t0, $t0, 12
+                     0x8c, 0x31, 0xc0, 0x28,
+                     // jr $t0
+                     0x80, 0x01, 0x00, 0x4c,
+                     // .quad <Target>
+                     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+  memcpy(Patch + 12, &Target, sizeof(Target));
+#else
+  uint8_t Patch[] = {// auipc t0, 0x0
+                     0x97, 0x02, 0x00, 0x00,
+                     // ld t0, 10(t0)
+                     0x83, 0xb2, 0xa2, 0x00,
+                     // c.jr t0
+                     0x82, 0x82,
+                     // .quad <Target>
+                     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+  memcpy(Patch + 10, &Target, sizeof(Target));
+#endif
+  memcpy(Dst, Patch, sizeof(Patch));
+}
+
+#if defined(__x86_64__)
+// Minimal x86-64 instruction length decoder, good enough for function
+// prologues.  Returns 0 for anything that cannot be relocated to a
+// trampoline (unsupported opcodes, RIP-relative operands), which makes the
+// caller skip patching instead of corrupting the function.
+static size_t x86InstrLen(const uint8_t *P) {
+  if (P[0] == 0xf3 && P[1] == 0x0f && P[2] == 0x1e &&
+      (P[3] == 0xfa || P[3] == 0xfb))  // endbr64/endbr32
+    return 4;
+
+  size_t I = 0;
+  while (P[I] == 0x66 || P[I] == 0x67 || P[I] == 0xf0 || P[I] == 0xf2 ||
+         P[I] == 0xf3 || P[I] == 0x2e || P[I] == 0x36 || P[I] == 0x3e ||
+         P[I] == 0x26 || P[I] == 0x64 || P[I] == 0x65)
+    ++I;
+
+  bool RexW = false;
+  if ((P[I] & 0xf0) == 0x40) {  // REX
+    RexW = (P[I] & 0x08) != 0;
+    ++I;
+  }
+
+  const uint8_t Op = P[I++];
+  bool HasModRM = false;
+  size_t ImmSize = 0;
+  switch (Op) {
+  case 0x50 ... 0x5f:  // push/pop r64
+  case 0x90 ... 0x97:  // nop/xchg
+  case 0xc3:           // ret
+  case 0xf4:           // hlt
+    break;
+  case 0x68:  // push imm32
+    ImmSize = 4;
+    break;
+  case 0x6a:  // push imm8
+    ImmSize = 1;
+    break;
+  case 0x81:  // grp1 r/m, imm32
+    HasModRM = true;
+    ImmSize = 4;
+    break;
+  case 0x83:  // grp1 r/m, imm8
+    HasModRM = true;
+    ImmSize = 1;
+    break;
+  case 0x85:  // test
+    HasModRM = true;
+    break;
+  case 0x88:
+  case 0x89:
+  case 0x8a:
+  case 0x8b:  // mov
+    HasModRM = true;
+    break;
+  case 0x8d:  // lea
+    HasModRM = true;
+    break;
+  case 0xb8 ... 0xbf:  // mov r, imm
+    ImmSize = RexW ? 8 : 4;
+    break;
+  case 0xc7:  // mov r/m, imm32
+    HasModRM = true;
+    ImmSize = 4;
+    break;
+  case 0x0f: {  // two-byte opcode
+    switch (P[I++]) {
+    case 0x05:  // syscall
+    case 0x0b:  // ud2
+      break;
+    case 0x10:
+    case 0x11:
+    case 0x1f:  // nop
+    case 0x28:
+    case 0x29:
+    case 0x6e:
+    case 0x7e:
+    case 0xaf:
+    case 0xb6:
+    case 0xb7:
+    case 0xbe:
+    case 0xbf:
+      HasModRM = true;
+      break;
+    default:
+      return 0;
+    }
+    break;
+  }
+  default:
+    return 0;
+  }
+
+  if (HasModRM) {
+    const uint8_t ModRM = P[I++];
+    const uint8_t Mod = ModRM >> 6;
+    const uint8_t Rm = ModRM & 0x07;
+    if (Mod == 0 && Rm == 5)
+      return 0;  // RIP-relative, not valid after copying
+    if (Mod != 3 && Rm == 4) {
+      const uint8_t SIB = P[I++];
+      if (Mod == 0 && (SIB & 0x07) == 5)
+        return 0;  // RIP-relative with SIB
+    }
+    if (Mod == 1)
+      I += 1;
+    else if (Mod == 2)
+      I += 4;
+  }
+  return I + ImmSize;
+}
+#endif
+
+// Number of bytes occupied by whole instructions that have to be stolen from
+// the beginning of the function (>= JumpPatchSize), 0 if unsupported.
+static size_t ComputeStealSize(const void *Func) {
+#if defined(__x86_64__)
+  const auto *P = static_cast<const uint8_t *>(Func);
+  size_t StealSize = 0;
+  while (StealSize < JumpPatchSize) {
+    const size_t Len = x86InstrLen(P + StealSize);
+    if (Len == 0 || Len > 15)
+      return 0;
+    StealSize += Len;
+  }
+  return StealSize;
+#else
+  (void)Func;
+  return (JumpPatchSize + 3) & ~size_t{3};  // fixed width instructions
+#endif
+}
+
+namespace {
+// The real implementation is called through a free function pointer: the
+// calling convention of a non-virtual member function with a single
+// inheritance chain is the one of a free function taking 'this' first,
+// while a pointer to member function would carry a 'this' adjustment.
+using FormatDiagnostic3ArgTy =
+    void (*)(const Diagnostic *, const char *, const char *,
+             SmallVectorImpl<char> &);
+
+// Entry point of the real implementation (the trampoline once the function
+// entry has been patched).  Null until PatchFormatDiagnostic3Arg has run.
+FormatDiagnostic3ArgTy RealFormatDiagnostic3Arg = nullptr;
+
+void SetRealFormatDiagnostic3Arg(void *Addr) {
+  static_assert(sizeof(FormatDiagnostic3ArgTy) == sizeof(Addr));
+  memcpy(&RealFormatDiagnostic3Arg, &Addr, sizeof(Addr));
+}
+
+// Real implementation, resolved lazily for the case where this hook is
+// reached through symbol interposition (the entry has not been patched).
+FormatDiagnostic3ArgTy getRealFormatDiagnostic3Arg() {
+  if (RealFormatDiagnostic3Arg)
+    return RealFormatDiagnostic3Arg;
+  static const FormatDiagnostic3ArgTy FallbackReal = [] {
+    using MemFnTy = void (Diagnostic::*)(const char *, const char *,
+                                        SmallVectorImpl<char> &) const;
+    MemFnTy MemFn = &Diagnostic::FormatDiagnostic;
+    void *Self = nullptr;
+    static_assert(sizeof(MemFnTy) > sizeof(Self));
+    memcpy(&Self, &MemFn, sizeof(Self));  // code address comes first
+    return reinterpret_cast<FormatDiagnostic3ArgTy>(getRealFuncAddrImpl(
+        "_ZNK5clang10Diagnostic16FormatDiagnosticEPKcS2_"
+        "RN4llvm15SmallVectorImplIcEE",
+        Self));
+  }();
+  return FallbackReal;
+}
+}  // namespace
+
+void Diagnostic::FormatDiagnostic(const char *DiagStr, const char *DiagEnd,
+                                  SmallVectorImpl<char> &OutStr) const {
+  const auto RealFunc = getRealFormatDiagnostic3Arg();
+  if (!RealFunc)  // cannot happen once the entry has been patched
+    return;
+  StringRef Diag{DiagStr, static_cast<size_t>(DiagEnd - DiagStr)};
+  StringRef Translated = ::replace(Diag);
+  RealFunc(this, Translated.data(), Translated.data() + Translated.size(),
+           OutStr);
+}
+#endif
+
 #ifdef CLANG_I18N_LINK_DYLIB
 
