@@ -278,6 +526,65 @@ struct PatchFormatDiagnostic {
 };
 } // namespace
 
+namespace {
+
+// Patch the 3-argument overload of Diagnostic::FormatDiagnostic.  Unlike the
+// 1-argument overload it cannot be intercepted by symbol interposition in
+// LTO builds, so its entry point is overwritten with a jump to our
+// implementation.  The instructions stolen from the prologue are copied into
+// a trampoline which our implementation calls to reach the real code.
+struct PatchFormatDiagnostic3Arg {
+  PatchFormatDiagnostic3Arg() {
+    const auto *FuncName = "_ZNK5clang10Diagnostic16FormatDiagnosticE"
+                           "PKcS2_RN4llvm15SmallVectorImplIcEE";
+    auto MyFunc = dlsym(RTLD_DEFAULT, FuncName);
+    auto RealFunc = dlsym(RTLD_NEXT, FuncName);
+    if (!MyFunc || !RealFunc || MyFunc == RealFunc)
+      return;
+
+    const size_t StealSize = ComputeStealSize(RealFunc);
+    if (StealSize == 0)
+      return;
+
+    using namespace llvm::sys;
+    std::error_code EC;
+    auto Trampoline = Memory::allocateMappedMemory(
+        StealSize + JumpPatchSize, nullptr,
+        Memory::MF_READ | Memory::MF_WRITE | Memory::MF_EXEC, EC);
+    if (EC)
+      return;
+    memcpy(Trampoline.base(), RealFunc, StealSize);
+    WriteJump(static_cast<uint8_t *>(Trampoline.base()) + StealSize,
+              static_cast<const uint8_t *>(RealFunc) + StealSize);
+    SetRealFormatDiagnostic3Arg(Trampoline.base());
+
+    MemoryBlock Mem(RealFunc, JumpPatchSize);
+    if (Memory::protectMappedMemory(Mem, Memory::MF_RWE_MASK))
+      return;
+    WriteJump(static_cast<uint8_t *>(Mem.base()), MyFunc);
+    [[maybe_unused]] auto Ret =
+        Memory::protectMappedMemory(Mem, Memory::MF_READ | Memory::MF_EXEC);
+#if !defined(__x86_64__)
+    __builtin___clear_cache(reinterpret_cast<char *>(Mem.base()),
+                            reinterpret_cast<char *>(Mem.base()) +
+                                JumpPatchSize);
+#endif
+    if (getenv("CLANG_I18N_DEBUG"))
+      fprintf(stderr,
+              "[clang-i18n] patched Diagnostic::FormatDiagnostic("
+              "const char *, const char *, SmallVectorImpl<char> &) at "
+              "%p\n",
+              RealFunc);
+  }
+};
+
+// Apply the patch when the library is loaded: clangd and friends create their
+// DiagnosticsEngine inside libclang-cpp, so relying on the interposed
+// DiagnosticsEngine constructor is not enough.
+[[maybe_unused]] PatchFormatDiagnostic3Arg PatchFormatDiagnostic3ArgPatcher;
+
+}  // namespace
